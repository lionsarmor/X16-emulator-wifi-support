# Fetched on demand by fetch-sdl.sh, not vendored in git.
/app/jni/SDL/

# Machine-specific, generated by Android Studio / gradle on first build.
local.properties
.gradle/
.idea/
*.iml

# Build outputs.
/app/build/
/app/.cxx/
/build/

# Staged per-app files, written by bundle-app-android.sh at build time -
# not part of the generic template.
/app/src/main/assets/app/
/app/src/main/assets/launcher.cfg
